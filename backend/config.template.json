{
  "message_limit": 10,
  "whatsapp": {
    "templates": {
      "confirmation": {
        "sid": "HXcac79b661eeb2dcfdf2358195969e323",
        "description": "Template sent after AI response asking if farmer needs human help"
      },
      "reconnection": {
        "sid": "HXc1711d07d1b1b74589fc035fea0d4f52",
        "description": "Template sent to reconnect with farmer after escalation"
      },
      "broadcast": {
        "sid": "HX8658667a944883b1ceab9205b83d407b",
        "description": "Template send to confirm incoming broadcast message"
      }
    },
    "button_payloads": {
      "escalate": "escalate",
      "read_broadcast": "read_broadcast",
      "reconnect": "reconnect"
    }
  },
  "escalation": {
    "chat_history_limit": 20,
    "reply_history_limit": 10,
    "description": "Number of recent messages to include in chat history for AI context"
  },
  "openai": {
    "enabled": true,
    "default_model": "gpt-4o-mini",
    "temperature": 0.7,
    "max_tokens": 1000,
    "timeout": 30,
    "max_retries": 3,
    "models": {
      "chat": "gpt-4o-mini",
      "chat_advanced": "gpt-4o",
      "transcription": "whisper-1",
      "embedding": "text-embedding-3-small",
      "moderation": "omni-moderation-latest"
    },
    "features": {
      "speech_to_text": {
        "enabled": true,
        "language": "en",
        "response_format": "json",
        "temperature": 0,
        "description": "Convert voice/audio to text (NOT related to WHISPER message type)"
      },
      "onboarding": {
        "enabled": true,
        "model": "gpt-4o-mini",
        "temperature": 0.8,
        "max_tokens": 500,
        "system_prompt": "You are a helpful agricultural assistant helping farmers get started with AgriConnect. Be friendly, concise, and practical."
      },
      "content_moderation": {
        "enabled": true,
        "auto_flag": true
      },
      "structured_extraction": {
        "enabled": true,
        "model": "gpt-4o-mini",
        "temperature": 0
      }
    },
    "cost_tracking": {
      "enabled": true,
      "log_usage": true
    }
  },
  "crop_types": ["Avocado", "Potato", "Dairy"],
  "languages": [
    { "code": "en", "name": "English" }
  ],
  "age_groups": [
    { "label": "20-35", "min": 20, "max": 35 },
    { "label": "36-50", "min": 36, "max": 50 },
    { "label": "51+", "min": 51, "max": null }
  ],
  "administrative_hierarchy": {
    "country_code": "FSM",
    "delimiter": " > ",
    "levels": [
      { "level_index": 0, "name": "country", "display": { "en": "Country" } },
      { "level_index": 1, "name": "state", "display": { "en": "State" } },
      {
        "level_index": 2,
        "name": "municipality",
        "display": { "en": "Municipality" }
      }
    ]
  },
  "onboarding": {
    "enabled": true,
    "fields": [
      {
        "field_name": "language",
        "db_field": "language",
        "enabled": true,
        "required": true,
        "priority": 0,
        "field_type": "enum",
        "extraction_method": "extract_language",
        "max_attempts": 3,
        "labels": {
          "en": "Language"
        },
        "questions": {
          "en": "Welcome to AgriConnect! 🌱 Your agricultural advisory companion.\n\nChoose your language:\n1. English"
        },
        "success_messages": {
          "en": "Great! Your language preference has been set to English."
        }
      },
      {
        "field_name": "full_name",
        "db_field": "full_name",
        "enabled": true,
        "required": true,
        "priority": 1,
        "field_type": "string",
        "max_attempts": 1,
        "labels": {
          "en": "Name"
        },
        "questions": {
          "en": "Welcome to AgriConnect! 🌱 Your agricultural advisory companion.\n\nTo get started, what is your full name?"
        },
        "success_messages": {
          "en": "Thank you, {value}!"
        }
      },
      {
        "field_name": "administration",
        "db_field": "customer_administrative",
        "enabled": true,
        "required": true,
        "priority": 2,
        "field_type": "location",
        "extraction_method": "extract_location",
        "matching_method": "resolve_administration_ambiguity",
        "max_attempts": 3,
        "labels": {
          "en": "Location"
        },
        "questions": {
          "en": "Where is your farm located?\n\nPlease tell me your area (e.g. state or municipality):"
        },
        "success_messages": {
          "en": "Location saved as {value}."
        }
      },
      {
        "field_name": "gender",
        "db_field": "gender",
        "enabled": true,
        "required": false,
        "priority": 3,
        "field_type": "enum",
        "extraction_method": "extract_gender",
        "max_attempts": 2,
        "labels": {
          "en": "Gender"
        },
        "questions": {
          "en": "What is your gender?\n1. Male\n2. Female\n3. Other"
        },
        "success_messages": {
          "en": "Thank you for sharing."
        }
      }
    ]
  },
  "contact_info": {
    "name": "Admin",
    "phone_number": "+1234567891"
  },
  "weather": {
    "broadcast_enabled": false,
    "intent_enabled": true,
    "intent_keywords": [
      "weather",
      "forecast",
      "weather updates"
    ],
    "forecast_days": 6
  }
}
